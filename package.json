{
  "name": "modular-ui-kit-react",
  "version": "1.0.0",
  "description": "A modular, accessible TypeScript-driven UI library for React.",
  "type": "module",
  "license": "MIT",
  "author": "Eugenia Vitinschii",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "react18",
    "react19",
    "react-components",
    "ui-kit",
    "component-library",
    "typescript",
    "sass",
    "design-system",
    "frontend",
    "responsive-ui"
  ],
  "homepage": "https://github.com/eugenia-vitinschii/modular-ui-kit-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eugenia-vitinschii/modular-ui-kit-react.git"
  },
  "bugs": {
    "url": "https://github.com/eugenia-vitinschii/modular-ui-kit-react/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sass": "^1.105.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^4.5.4"
  }
}
